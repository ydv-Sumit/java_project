<?xml version="1.0" encoding="UTF-8"?>

<taglib>

    <tlib-version>1.0</tlib-version>
    
    <jsp-version>4.0</jsp-version>

    <tag>
        <name>sum</name>
        <tag-class>mypack.MyHandler</tag-class>
        
        <attribute>
        <name>num1</name>
        <required>true</required>
       <rtexprvalue>true</rtexprvalue>    <!-- runtime par expression(<%= %>) me value bhejana chate ho -->
        </attribute>
        
          <attribute>
        <name>num2</name>
        <required>true</required>
       <rtexprvalue>true</rtexprvalue> 
        </attribute>
        
        
    </tag>

</taglib>